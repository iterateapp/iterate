# ── Local Database (Docker) ─────────────────────────────────────────
DATABASE_URL=postgresql://iterate:iterate@localhost:5433/iterate_dev
DIRECT_URL=postgresql://iterate:iterate@localhost:5433/iterate_dev

# ── Supabase (production) ──────────────────────────────────────────
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_PASSWORD=your-db-password
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── AI Providers (optional — needed for /api/ai/chat) ──────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Gmail (optional — for interview invitations) ───────────────────
# GMAIL_ADDRESS=your-email@gmail.com
# GMAIL_PASSWORD=your-app-password
